{
  "name": "@astrobytes/myst-reveal",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "A bounded MyST-to-Reveal lecture prototype",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "node src/build.mjs examples/prototype",
    "build:features": "node src/build.mjs examples/features _build/html/reveal/features.html",
    "build:all": "npm run build && npm run build:features && npm run build:courses",
    "dev": "node src/dev.mjs",
    "test": "node --test --test-concurrency=1 test/*.test.mjs",
    "preview": "node src/preview.mjs",
    "build:courses": "node src/build.mjs examples/courses _build/html/reveal",
    "check": "node src/check.mjs",
    "bundle:python": "node src/bundle-python.mjs",
    "rehearse": "node src/rehearse.mjs"
  },
  "dependencies": {
    "katex": "0.16.22",
    "mdast-util-to-hast": "12.3.0",
    "myst-to-html": "1.7.4",
    "mystmd": "1.10.1",
    "rehype-stringify": "9.0.4",
    "reveal.js": "5.1.0",
    "unified": "10.1.2"
  },
  "devDependencies": {
    "playwright": "1.55.1"
  }
}
